# Only the demanded item counts. `if score #item matches N` short-circuits before the
# entity selector, so exactly one branch does real work per tick.
# Some demands accept several ids: 26.2 eggs vary by chicken variant, wool by sheep colour.
execute at @e[tag=20min.altar,limit=1] unless block ~ ~ ~ minecraft:lodestone run function 20min:altar/broken
scoreboard players set #took 20min.s 0
execute if score #item 20min.s matches 1 at @e[tag=20min.altar,limit=1] as @e[type=item,distance=..3,nbt={Item:{id:"minecraft:cobblestone"}}] run function 20min:altar/take
